# Mumbai Air Atlas — Environment Variables

# Backend Configuration
PORT=8000
HOST=0.0.0.0
ENVIRONMENT=development
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# OpenAQ API Key (Optional for development; required for live OpenAQ station observations)
# Obtain a free key at: https://explore.openaq.org
OPENAQ_API_KEY=

# Open-Meteo Configuration (No API key needed for non-commercial open use)
OPEN_METEO_BASE_URL=https://api.open-meteo.com/v1
OPEN_METEO_AQ_BASE_URL=https://air-quality-api.open-meteo.com/v1

# Geographic defaults (Greater Mumbai)
MUMBAI_LATITUDE=19.0760
MUMBAI_LONGITUDE=72.8777
MUMBAI_SEARCH_RADIUS_METERS=35000
