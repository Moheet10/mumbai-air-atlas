{
  "version": 2,
  "buildCommand": "npm --prefix frontend run build",
  "outputDirectory": "frontend/dist",
  "functions": {
    "api/index.py": {
      "includeFiles": "backend/data/snapshot/**,backend/data/station_models.pkl,backend/data/station_model_evaluation.json,backend/data/anomalies.json,backend/app/**",
      "excludeFiles": "backend/data/station_cache/**,backend/data/mumbai_air.db*,backend/data/lgbm_model.pkl,backend/tests/**,docs/**,tests/**,frontend/**"
    }
  },
  "rewrites": [
    { "source": "/api", "destination": "/api/index.py" },
    { "source": "/api/(.*)", "destination": "/api/index.py" }
  ]
}
